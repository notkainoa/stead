+constexpr int kRowChildSpacing = 7;
+constexpr char16_t kBookmarksSectionTitle[] = u"Bookmarks";
+
+bool IsButtonHovered(const views::Button* button) {
+  return button->GetState() == views::Button::STATE_HOVERED ||
+         button->GetState() == views::Button::STATE_PRESSED;
+}
+
+}  // namespace
+
+class VerticalSidebarBookmarksView::BookmarkRow : public views::Button {
+ public:
+  BookmarkRow(VerticalSidebarBookmarksView* owner,
+              const bookmarks::BookmarkNode* bookmark)
+      : views::Button(
+            base::BindRepeating(&VerticalSidebarBookmarksView::ActivateOrOpen,
+                                base::Unretained(owner),
+                                bookmark)),
+        owner_(owner),
+        bookmark_(bookmark),
+        tab_style_(TabStyle::Get()) {
+    SetNotifyEnterExitOnChild(true);
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+    SetAnimationDuration(base::Milliseconds(80));
+    SetPreferredSize(
+        gfx::Size(-1, GetLayoutConstant(LayoutConstant::kVerticalTabHeight)));
+
+    auto* layout = SetLayoutManager(std::make_unique<views::FlexLayout>());
+    layout->SetOrientation(views::LayoutOrientation::kHorizontal)
+        .SetCrossAxisAlignment(views::LayoutAlignment::kCenter)
+        .SetInteriorMargin(gfx::Insets::VH(0, kRowHorizontalInset))
+        .SetDefault(views::kMarginsKey,
+                    gfx::Insets().set_right(kRowChildSpacing));
+
+    favicon_ = AddChildView(std::make_unique<views::ImageView>());
+    favicon_->SetImageSize(gfx::Size(gfx::kFaviconSize, gfx::kFaviconSize));
+    favicon_->SetCanProcessEventsWithinSubtree(false);
+
+    title_ = AddChildView(std::make_unique<views::Label>(bookmark->GetTitle()));
+    title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title_->SetTextStyle(views::style::STYLE_BODY_4);
+    title_->SetElideBehavior(gfx::ELIDE_TAIL);
+    title_->SetCanProcessEventsWithinSubtree(false);
+    title_->SetSkipSubpixelRenderingOpacityCheck(true);
+    title_->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::LayoutOrientation::kHorizontal,
+                                 views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kUnbounded, true));
+
+    close_button_ = AddChildView(std::make_unique<TabCloseButton>(
+        base::BindRepeating(&VerticalSidebarBookmarksView::CloseOpenTab,
+                            base::Unretained(owner), bookmark),
+        base::BindRepeating(&BookmarkRow::OnCloseButtonMouseEvent,
+                            base::Unretained(this))));
+    close_button_->SetProperty(views::kMarginsKey, gfx::Insets());
+
+    views::FocusRing::Install(this);
+    views::FocusRing::Get(this)->SetOutsetFocusRingDisabled(true);
+    views::HighlightPathGenerator::Install(
+        this, std::make_unique<views::RoundRectHighlightPathGenerator>(
+                  gfx::Insets(),
+                  GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius)));
+
+    GetViewAccessibility().SetRole(ax::mojom::Role::kTab);
+    UpdateFavicon();
+    UpdateState();
+  }
+
+  ~BookmarkRow() override = default;
+
+  void SetTabStripCollapsed(bool collapsed) {
+    if (tab_strip_collapsed_ == collapsed) {
+      return;
+    }
+    tab_strip_collapsed_ = collapsed;
+    title_->SetVisible(!collapsed);
+    UpdateVisuals();
+    InvalidateLayout();
+  }
+
+  void UpdateFavicon() {
+    const gfx::Image& favicon = owner_->bookmark_model_->GetFavicon(bookmark_);
+    if (favicon.IsEmpty()) {
+      favicon_->SetImage(ui::ImageModel::FromVectorIcon(
+          vector_icons::kGlobeIcon, ui::kColorIcon, gfx::kFaviconSize));
+    } else {
+      favicon_->SetImage(ui::ImageModel::FromImageSkia(favicon.AsImageSkia()));
+    }
+  }
+
+  void UpdateState() {
+    const int open_index = owner_->FindOpenTab(bookmark_);
+    is_open_ = open_index != TabStripModel::kNoTab;
+    is_active_ = is_open_ && owner_->tab_strip_model_ &&
+                 owner_->tab_strip_model_->active_index() == open_index;
+
+    std::u16string accessible_name = bookmark_->GetTitle();
+    accessible_name.append(is_open_ ? u", open tab" : u", closed tab");
+    GetViewAccessibility().SetName(accessible_name);
+    GetViewAccessibility().SetIsSelected(is_active_);
+    UpdateVisuals();
+  }
+
+  const bookmarks::BookmarkNode* bookmark() const { return bookmark_; }
+
+ private:
+  void StateChanged(ButtonState old_state) override {
+    views::Button::StateChanged(old_state);
+    UpdateVisuals();
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (event.IsOnlyMiddleMouseButton() && HitTestPoint(event.location())) {
+      owner_->CloseOpenTab(bookmark_);
+      return;
+    }
+    views::Button::OnMouseReleased(event);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const bool hovered = IsButtonHovered(this);
+    if (is_active_ || hovered) {
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(tab_style_->GetCurrentTabBackgroundColor(
+          is_active_ ? TabStyle::TabSelectionState::kActive
+                     : TabStyle::TabSelectionState::kInactive,
+          hovered, hovered ? 1.0 : 0.0,
+          GetWidget() ? GetWidget()->ShouldPaintAsActive() : true,
+          GetColorProvider()));
+      canvas->DrawRoundRect(
+          GetContentsBounds(),
+          GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius), flags);
+    }
+    views::Button::PaintButtonContents(canvas);
+  }
+
+  void OnThemeChanged() override {
+    views::Button::OnThemeChanged();
+    UpdateVisuals();
+  }
+
+  void OnCloseButtonMouseEvent(views::View* source,
+                               const ui::MouseEvent& event) {
+    if (event.type() == ui::EventType::kMouseReleased &&
+        event.IsMiddleMouseButton()) {
+      owner_->CloseOpenTab(bookmark_);
+    }
+  }
+
+  void UpdateVisuals() {
+    const bool hovered = IsButtonHovered(this);
+    const TabStyle::TabSelectionState selection_state =
+        is_active_ ? TabStyle::TabSelectionState::kActive
+                   : TabStyle::TabSelectionState::kInactive;
+    TabStyle::TabColors colors = tab_style_->CalculateTargetColors(
+        selection_state, is_active_, hovered,
+        GetWidget() ? GetWidget()->ShouldPaintAsActive() : true,
+        GetColorProvider());
+    title_->SetEnabledColor(colors.foreground_color);
+    close_button_->SetColors(colors);
+    close_button_->SetVisible(is_open_ && !tab_strip_collapsed_ &&
+                              (is_active_ || hovered));
+    SchedulePaint();
+  }
+
+  raw_ptr<VerticalSidebarBookmarksView> owner_;
+  raw_ptr<const bookmarks::BookmarkNode> bookmark_;
+  raw_ptr<const TabStyle> tab_style_;
+  raw_ptr<views::ImageView> favicon_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<TabCloseButton> close_button_ = nullptr;
+  bool is_open_ = false;
+  bool is_active_ = false;
+  bool tab_strip_collapsed_ = false;
+};
+
+VerticalSidebarBookmarksView::VerticalSidebarBookmarksView(
+    TabStripModel* tab_strip_model)
+    : bookmark_model_(BookmarkModelFactory::GetForBrowserContext(
+          tab_strip_model->profile())),
+      tab_strip_model_(tab_strip_model) {
+  CHECK(bookmark_model_);
+  CHECK(tab_strip_model_);
+
+  SetLayoutManager(std::make_unique<views::FlexLayout>())
+      ->SetOrientation(views::LayoutOrientation::kVertical)
+      .SetCrossAxisAlignment(views::LayoutAlignment::kStretch);
+  SetNotifyEnterExitOnChild(true);
+
+  header_button_ = AddChildView(std::make_unique<views::ImageButton>(
+      base::BindRepeating(&VerticalSidebarBookmarksView::ToggleSection,
+                          base::Unretained(this))));
+  header_button_->SetPreferredSize(gfx::Size(-1, kHeaderHeight));
+  header_button_->SetNotifyEnterExitOnChild(true);
+  header_button_->SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+  header_button_->SetInstallFocusRingOnFocus(true);
+  header_button_->SetTooltipText(kBookmarksSectionTitle);
+  views::HighlightPathGenerator::Install(
+      header_button_,
+      std::make_unique<views::RoundRectHighlightPathGenerator>(
+          gfx::Insets(),
+          GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius)));
+
+  auto* header_layout =
+      header_button_->SetLayoutManager(std::make_unique<views::FlexLayout>());
+  header_layout->SetOrientation(views::LayoutOrientation::kHorizontal)
+      .SetCrossAxisAlignment(views::LayoutAlignment::kCenter)
+      .SetInteriorMargin(gfx::Insets::VH(0, kRowHorizontalInset))
+      .SetDefault(views::kMarginsKey,
+                  gfx::Insets().set_right(kRowChildSpacing));
+
+  header_label_ = header_button_->AddChildView(
+      std::make_unique<views::Label>(kBookmarksSectionTitle));
+  header_label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  header_label_->SetTextStyle(views::style::STYLE_BODY_5_MEDIUM);
+  header_label_->SetEnabledColor(ui::kColorLabelForegroundSecondary);
+  header_label_->SetCanProcessEventsWithinSubtree(false);
+  header_label_->SetSkipSubpixelRenderingOpacityCheck(true);
+  header_label_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::LayoutOrientation::kHorizontal,
+                               views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded, true));
+
+  header_icon_ =
+      header_button_->AddChildView(std::make_unique<views::ImageView>());
+  header_icon_->SetImageSize(gfx::Size(kHeaderIconSize, kHeaderIconSize));
+  header_icon_->SetCanProcessEventsWithinSubtree(false);
+  header_icon_->SetProperty(views::kMarginsKey, gfx::Insets());
+
+  rows_container_ = AddChildView(std::make_unique<views::View>());
+  rows_container_->SetLayoutManager(std::make_unique<views::FlexLayout>())
+      ->SetOrientation(views::LayoutOrientation::kVertical)
+      .SetCrossAxisAlignment(views::LayoutAlignment::kStretch);
+
+  bookmark_model_->AddObserver(this);
+  tab_strip_model_->AddObserver(this);
+  InitializeBookmarkModel();
+  UpdateHeader();
+}
+
+VerticalSidebarBookmarksView::~VerticalSidebarBookmarksView() {
+  if (bookmark_model_) {
+    bookmark_model_->RemoveObserver(this);
+  }
+  if (tab_strip_model_) {
+    tab_strip_model_->RemoveObserver(this);
+  }
+}
+
+void VerticalSidebarBookmarksView::SetTabStripCollapsed(bool collapsed) {
+  if (tab_strip_collapsed_ == collapsed) {
+    return;
+  }
+  tab_strip_collapsed_ = collapsed;
+  header_label_->SetVisible(!collapsed);
+  for (BookmarkRow* row : rows_) {
+    row->SetTabStripCollapsed(collapsed);
+  }
+  UpdateHeader();
+  InvalidateLayout();
+}
+
+void VerticalSidebarBookmarksView::InitializeBookmarkModel() {
+  if (bookmark_model_->loaded()) {
+    RefreshFolderAndRows();
+  }
+}
+
+void VerticalSidebarBookmarksView::RefreshFolderAndRows() {
+  if (!bookmark_model_ || !bookmark_model_->loaded()) {
+    return;
+  }
+  sidebar_folder_ = EnsureSteadSidebarBookmarkFolder(bookmark_model_);
+  RebuildRows();
+}
+
+void VerticalSidebarBookmarksView::RebuildRows() {
+  rows_.clear();
+  rows_container_->RemoveAllChildViews();
+
+  if (sidebar_folder_) {
+    for (const auto& child : sidebar_folder_->children()) {
+      if (!child->is_url()) {
+        continue;
+      }
+      std::unique_ptr<views::View> row_view =
+          std::make_unique<BookmarkRow>(this, child.get());
+      auto* row = static_cast<BookmarkRow*>(row_view.get());
+      rows_container_->AddChildView(std::move(row_view));
+      row->SetTabStripCollapsed(tab_strip_collapsed_);
+      rows_.push_back(row);
+    }
+  }
+
+  rows_container_->SetVisible(section_expanded_ && !rows_.empty());
+  UpdateHeader();
+  PreferredSizeChanged();
+}
+
+void VerticalSidebarBookmarksView::UpdateRowsState() {
+  for (BookmarkRow* row : rows_) {
+    row->UpdateState();
+  }
+}
+
+void VerticalSidebarBookmarksView::ToggleSection() {
+  section_expanded_ = !section_expanded_;
+  rows_container_->SetVisible(section_expanded_ && !rows_.empty());
+  UpdateHeader();
+  PreferredSizeChanged();
+}
+
+void VerticalSidebarBookmarksView::UpdateHeader() {
+  const gfx::VectorIcon& icon = section_expanded_
+                                    ? kKeyboardArrowDownChromeRefreshIcon
+                                    : kChevronRightChromeRefreshIcon;
+  header_icon_->SetImage(ui::ImageModel::FromVectorIcon(
+      icon, ui::kColorIconSecondary, kHeaderIconSize));
+  header_icon_->SetVisible(tab_strip_collapsed_ || !section_expanded_ ||
+                           section_hovered_);
+  header_button_->GetViewAccessibility().SetName(kBookmarksSectionTitle);
+  if (section_expanded_) {
+    header_button_->GetViewAccessibility().SetIsExpanded();
+  } else {
+    header_button_->GetViewAccessibility().SetIsCollapsed();
+  }
+}
+
+void VerticalSidebarBookmarksView::OnMouseEntered(const ui::MouseEvent& event) {
+  views::View::OnMouseEntered(event);
+  section_hovered_ = true;
+  UpdateHeader();
+}
+
+void VerticalSidebarBookmarksView::OnMouseExited(const ui::MouseEvent& event) {
+  views::View::OnMouseExited(event);
+  section_hovered_ = false;
+  UpdateHeader();
+}
+
+int VerticalSidebarBookmarksView::FindOpenTab(
+    const bookmarks::BookmarkNode* bookmark) const {
+  if (!tab_strip_model_ || !bookmark || !bookmark->is_url()) {
+    return TabStripModel::kNoTab;
+  }
+  for (int index = 0; index < tab_strip_model_->count(); ++index) {
+    content::WebContents* contents = tab_strip_model_->GetWebContentsAt(index);
+    if (contents && contents->GetVisibleURL() == bookmark->url()) {
+      return index;
+    }
+  }
+  return TabStripModel::kNoTab;
+}
+
+void VerticalSidebarBookmarksView::ActivateOrOpen(
+    const bookmarks::BookmarkNode* bookmark) {
+  if (!tab_strip_model_) {
+    return;
+  }
+  const int open_index = FindOpenTab(bookmark);
+  if (open_index != TabStripModel::kNoTab) {
+    tab_strip_model_->ActivateTabAt(
+        open_index, TabStripUserGestureDetails(
+                        TabStripUserGestureDetails::GestureType::kMouse));
+    return;
+  }
+  tab_strip_model_->delegate()->AddTabAt(bookmark->url(), -1, true);
+}
+
+void VerticalSidebarBookmarksView::CloseOpenTab(
+    const bookmarks::BookmarkNode* bookmark) {
+  if (!tab_strip_model_) {
+    return;
+  }
+  const int open_index = FindOpenTab(bookmark);
+  if (open_index != TabStripModel::kNoTab) {
+    tab_strip_model_->CloseWebContentsAt(
+        open_index, TabCloseTypes::CLOSE_USER_GESTURE |
+                        TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+}
+
+void VerticalSidebarBookmarksView::BookmarkModelLoaded(bool ids_reassigned) {
+  RefreshFolderAndRows();
+}
+
+void VerticalSidebarBookmarksView::BookmarkModelBeingDeleted() {
+  bookmark_model_ = nullptr;
+  sidebar_folder_ = nullptr;
+  rows_.clear();
+  rows_container_->RemoveAllChildViews();
+  rows_container_->SetVisible(false);
+  UpdateHeader();
+  PreferredSizeChanged();
+}
+
+void VerticalSidebarBookmarksView::BookmarkNodeMoved(
+    const bookmarks::BookmarkNode* old_parent,
+    size_t old_index,
+    const bookmarks::BookmarkNode* new_parent,
+    size_t new_index) {
+  if (!extensive_changes_ &&
+      (old_parent == sidebar_folder_ || new_parent == sidebar_folder_ ||
+       old_parent == bookmark_model_->other_node() ||
+       new_parent == bookmark_model_->other_node())) {
+    RefreshFolderAndRows();
+  }
+}
+
+void VerticalSidebarBookmarksView::BookmarkNodeAdded(
+    const bookmarks::BookmarkNode* parent,
+    size_t index,
+    bool added_by_user) {
+  if (!extensive_changes_ &&
+      (parent == sidebar_folder_ || parent == bookmark_model_->other_node())) {
+    RefreshFolderAndRows();
+  }
+}
+
+void VerticalSidebarBookmarksView::BookmarkNodeRemoved(
+    const bookmarks::BookmarkNode* parent,
+    size_t old_index,
+    const bookmarks::BookmarkNode* node,
+    const std::set<GURL>& no_longer_bookmarked,
+    const base::Location& location) {
+  if (!extensive_changes_ &&
+      (parent == sidebar_folder_ || node == sidebar_folder_ ||
+       parent == bookmark_model_->other_node())) {
+    if (node == sidebar_folder_) {
+      sidebar_folder_ = nullptr;
+      RebuildRows();
+      return;
+    }
+    sidebar_folder_ = nullptr;
+    RefreshFolderAndRows();
+  }
+}
+
+void VerticalSidebarBookmarksView::BookmarkNodeChanged(
+    const bookmarks::BookmarkNode* node) {
+  if (!extensive_changes_ &&
+      (node == sidebar_folder_ || node->parent() == sidebar_folder_)) {
+    RefreshFolderAndRows();
+  }
+}
+
+void VerticalSidebarBookmarksView::BookmarkNodeFaviconChanged(
+    const bookmarks::BookmarkNode* node) {
+  if (node->parent() != sidebar_folder_) {
+    return;
+  }
+  for (BookmarkRow* row : rows_) {
+    if (row->bookmark() == node) {
+      row->UpdateFavicon();
+      return;
+    }
+  }
+}
+
+void VerticalSidebarBookmarksView::BookmarkNodeChildrenReordered(
+    const bookmarks::BookmarkNode* node) {
+  if (!extensive_changes_ && node == sidebar_folder_) {
+    RebuildRows();
+  }
+}
+
+void VerticalSidebarBookmarksView::ExtensiveBookmarkChangesBeginning() {
+  extensive_changes_ = true;
+}
+
+void VerticalSidebarBookmarksView::ExtensiveBookmarkChangesEnded() {
+  extensive_changes_ = false;
+  RefreshFolderAndRows();
+}
+
+void VerticalSidebarBookmarksView::BookmarkAllUserNodesRemoved(
+    const std::set<GURL>& removed_urls,
+    const base::Location& location) {
+  sidebar_folder_ = nullptr;
+  RebuildRows();
+}
+
+void VerticalSidebarBookmarksView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  UpdateRowsState();
+}
+
+void VerticalSidebarBookmarksView::OnTabChangedAt(tabs::TabInterface* tab,
+                                                  int index,
+                                                  TabChangeType change_type) {
+  UpdateRowsState();
+}
+
+void VerticalSidebarBookmarksView::OnTabStripModelDestroyed(
+    TabStripModel* tab_strip_model) {
+  tab_strip_model_ = nullptr;
+}
