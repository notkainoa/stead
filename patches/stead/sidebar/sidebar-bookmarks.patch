+inline constexpr char16_t kSteadSidebarBookmarkFolderName[] = u"Sidebar";
+
+// Returns the first folder named "Sidebar" directly under Other Bookmarks.
+// The folder remains an ordinary bookmark folder so bookmark sync, editing,
+// import, and export keep their existing behavior.
