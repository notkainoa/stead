+// Copyright 2026 The Stead Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/bookmarks/stead_sidebar_bookmark_utils.h"
+
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+
+const bookmarks::BookmarkNode* FindSteadSidebarBookmarkFolder(
+    const bookmarks::BookmarkModel* model) {
+  if (!model || !model->loaded() || !model->other_node()) {
+    return nullptr;
+  }
+
+  for (const auto& child : model->other_node()->children()) {
+    if (child->is_folder() &&
+        child->GetTitle() == kSteadSidebarBookmarkFolderName) {
+      return child.get();
+    }
+  }
+  return nullptr;
+}
+
+const bookmarks::BookmarkNode* EnsureSteadSidebarBookmarkFolder(
+    bookmarks::BookmarkModel* model) {
+  if (!model || !model->loaded()) {
+    return nullptr;
+  }
+  if (const bookmarks::BookmarkNode* existing =
+          FindSteadSidebarBookmarkFolder(model)) {
+    return existing;
+  }
+  return model->AddFolder(model->other_node(), 0,
+                          kSteadSidebarBookmarkFolderName);
+}
