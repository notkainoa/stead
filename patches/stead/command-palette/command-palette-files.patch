+
+class BrowserView;
+class BrowserWindowInterface;
+class SteadCommandPaletteUI;
+
+// Per-window owner of the Cmd+T command palette bubble. Created by
+// BrowserWindowFeatures for normal browser windows; the bubble is a
+// WebUIBubbleDialogView floating over the window's content area and hosting
+// SteadCommandPaletteUI. Closes with Esc, focus loss, or tab activation.
+class SteadCommandPaletteBubbleHost : public WebUIBubbleManagerObserver {
+ public:
+  DECLARE_USER_DATA(SteadCommandPaletteBubbleHost);
+
+  SteadCommandPaletteBubbleHost(BrowserWindowInterface* browser_window,
+                                BrowserView* browser_view);
+  SteadCommandPaletteBubbleHost(const SteadCommandPaletteBubbleHost&) = delete;
+  SteadCommandPaletteBubbleHost& operator=(
+      const SteadCommandPaletteBubbleHost&) = delete;
+  ~SteadCommandPaletteBubbleHost() override;
+
+  static SteadCommandPaletteBubbleHost* From(
+      BrowserWindowInterface* browser_window);
+
+  // Shows the palette, or closes it if it is already open. Returns true if a
+  // bubble was shown.
+  bool Toggle();
+  void Close();
+
+  // WebUIBubbleManagerObserver:
+  void BeforeBubbleWidgetShowed(views::Widget* widget) override;
+
+ private:
+  SteadCommandPaletteUI* GetPaletteUI();
+
+  const raw_ptr<BrowserView> browser_view_;
+  std::unique_ptr<WebUIBubbleManager> bubble_manager_;
+  base::ScopedObservation<WebUIBubbleManager, WebUIBubbleManagerObserver>
+      bubble_manager_observation_{this};
+  ui::ScopedUnownedUserData<SteadCommandPaletteBubbleHost>
+      scoped_unowned_user_data_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_STEAD_COMMAND_PALETTE_STEAD_COMMAND_PALETTE_BUBBLE_HOST_H_
