+// Copyright 2026 The Stead Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/stead_command_palette/stead_command_palette_bubble_host.h"
+
+#include <optional>
+
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/webui/stead_command_palette/stead_command_palette_ui.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/generated_resources.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/bubble/bubble_border.h"
+#include "ui/views/widget/widget.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Vertical offset of the palette from the top of the content area, so it sits
+// like a spotlight rather than dead-centre.
+constexpr int kPaletteTopOffset = 96;
+
+}  // namespace
+
+DEFINE_USER_DATA(SteadCommandPaletteBubbleHost);
+
+SteadCommandPaletteBubbleHost::SteadCommandPaletteBubbleHost(
+    BrowserWindowInterface* browser_window,
+    BrowserView* browser_view)
+    : browser_view_(browser_view),
+      bubble_manager_(WebUIBubbleManager::Create<SteadCommandPaletteUI>(
+          browser_view->contents_container(),
+          browser_window,
+          GURL(chrome::kSteadCommandPaletteURL),
+          IDS_STEAD_COMMAND_PALETTE_TITLE)),
+      scoped_unowned_user_data_(browser_window->GetUnownedUserDataHost(),
+                                *this) {
+  bubble_manager_observation_.Observe(bubble_manager_.get());
+}
+
+SteadCommandPaletteBubbleHost::~SteadCommandPaletteBubbleHost() = default;
+
+// static
+SteadCommandPaletteBubbleHost* SteadCommandPaletteBubbleHost::From(
+    BrowserWindowInterface* browser_window) {
+  return Get(browser_window->GetUnownedUserDataHost());
+}
+
+bool SteadCommandPaletteBubbleHost::Toggle() {
+  if (bubble_manager_->GetBubbleWidget()) {
+    Close();
+    return false;
+  }
+
+  // Anchor to a zero-height strip near the top of the content area; NONE
+  // places the bubble directly below the anchor, horizontally centred.
+  gfx::Rect anchor = browser_view_->contents_container()->GetBoundsInScreen();
+  anchor.set_height(0);
+  anchor.Offset(0, kPaletteTopOffset);
+  return bubble_manager_->ShowBubble(anchor, views::BubbleBorder::NONE);
+}
+
+void SteadCommandPaletteBubbleHost::Close() {
+  bubble_manager_->CloseBubble();
+}
+
+void SteadCommandPaletteBubbleHost::BeforeBubbleWidgetShowed(
+    views::Widget* widget) {
+  // The bubble manager caches the WebContents between shows, so the page must
+  // reset its query rather than relying on a fresh load.
+  if (SteadCommandPaletteUI* palette_ui = GetPaletteUI()) {
+    palette_ui->BeforeBubbleWidgetShowed();
+  }
+}
+
+SteadCommandPaletteUI* SteadCommandPaletteBubbleHost::GetPaletteUI() {
+  WebUIContentsWrapper* wrapper = bubble_manager_->GetContentsWrapper();
+  content::WebContents* contents = wrapper ? wrapper->web_contents() : nullptr;
+  content::WebUI* web_ui = contents ? contents->GetWebUI() : nullptr;
+  return web_ui ? web_ui->GetController()->GetAs<SteadCommandPaletteUI>()
+                : nullptr;
+}
