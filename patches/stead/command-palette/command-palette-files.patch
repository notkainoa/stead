+#include "content/public/browser/url_data_source.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "third_party/metrics_proto/omnibox_event.pb.h"
+#include "ui/base/base_window.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/webui/webui_util.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr size_t kMaxTabResults = 12;
+constexpr size_t kMaxBookmarkResults = 6;
+constexpr int kMaxHistoryResults = 8;
+
+base::DictValue MakeResult(std::string_view kind,
+                           std::u16string_view title,
+                           const GURL& url) {
+  base::DictValue result;
+  result.Set("kind", kind);
+  result.Set("title", title);
+  result.Set("url", url.spec());
+  return result;
+}
+
+bool ContainsIgnoringCase(std::u16string_view haystack,
+                          const std::u16string& needle_lower) {
+  if (needle_lower.empty()) {
+    return true;
+  }
+  return base::i18n::ToLower(haystack).find(needle_lower) !=
+         std::u16string::npos;
+}
+
+bool IsSearchableUrl(const GURL& url) {
+  return url.is_valid() && (url.SchemeIsHTTPOrHTTPS() || url.SchemeIsFile());
+}
+
+}  // namespace
+
+bool SteadCommandPaletteUIConfig::ShouldAutoResizeHost() {
+  return true;
+}
+
+SteadCommandPaletteUI::SteadCommandPaletteUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/true) {
+  web_ui->RegisterMessageCallback(
+      "steadPaletteReady",
+      base::BindRepeating(&SteadCommandPaletteUI::HandleReady,
+                          base::Unretained(this)));
+  web_ui->RegisterMessageCallback(
+      "steadPaletteClose",
+      base::BindRepeating(&SteadCommandPaletteUI::HandleClose,
+                          base::Unretained(this)));
+  web_ui->RegisterMessageCallback(
+      "steadPaletteSearch",
+      base::BindRepeating(&SteadCommandPaletteUI::HandleSearch,
+                          base::Unretained(this)));
+  web_ui->RegisterMessageCallback(
+      "steadPaletteOpen",
+      base::BindRepeating(&SteadCommandPaletteUI::HandleOpen,
+                          base::Unretained(this)));
+  // The shared SPA layout probes for a theme handler on every surface.
+  web_ui->RegisterMessageCallback("getSteadTheme", base::DoNothing());
+
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::URLDataSource::Add(
+      profile, std::make_unique<FaviconSource>(
+                   profile, chrome::FaviconUrlFormat::kFavicon2));
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kSteadCommandPaletteHost);
+
+  // index.html is the default resource so /command-palette falls back to the
+  // SPA shell and SvelteKit's router renders the route.
+  webui::SetupWebUIDataSource(source, kSteadSidebarResources,
+                              IDR_STEAD_SIDEBAR_INDEX_HTML);
+
+  // Same CSP relaxations as the other Stead surfaces: SvelteKit boots from an
+  // inline <script> and the bundle uses inline style="" attributes.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src chrome://resources 'self' 'unsafe-inline';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::StyleSrc,
+      "style-src 'self' 'unsafe-inline';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::FontSrc, "font-src 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc,
+      "img-src 'self' data: chrome://resources chrome://theme "
+      "chrome://favicon2;");
+  source->DisableTrustedTypesCSP();
+}
+
+SteadCommandPaletteUI::~SteadCommandPaletteUI() = default;
+
+void SteadCommandPaletteUI::BeforeBubbleWidgetShowed() {
+  web_ui()->CallJavascriptFunctionUnsafe("steadPaletteReset");
+}
+
+BrowserWindowInterface* SteadCommandPaletteUI::GetBrowserWindow() {
+  // Set by WebUIBubbleManager before the bubble is created.
+  if (BrowserWindowInterface* window =
+          webui::GetBrowserWindowInterface(web_ui()->GetWebContents())) {
+    return window;
+  }
+  return ProfileBrowserCollection::GetForProfile(Profile::FromWebUI(web_ui()))
+      ->FindTabbedBrowser();
+}
+
+void SteadCommandPaletteUI::HandleReady(const base::ListValue&) {
+  if (embedder()) {
+    embedder()->ShowUI();
+  }
+}
+
+void SteadCommandPaletteUI::HandleClose(const base::ListValue&) {
+  if (embedder()) {
+    embedder()->CloseUI();
+  }
+}
+
+void SteadCommandPaletteUI::HandleSearch(const base::ListValue& args) {
+  if (args.size() < 2 || !args[0].is_int() || !args[1].is_string()) {
+    return;
+  }
+  const int request_id = args[0].GetInt();
+  std::u16string query = base::UTF8ToUTF16(args[1].GetString());
+  base::TrimWhitespace(query, base::TRIM_ALL, &query);
+  const std::u16string query_lower = base::i18n::ToLower(query);
+
+  Profile* profile = Profile::FromWebUI(web_ui());
+  BrowserWindowInterface* window = GetBrowserWindow();
+  base::ListValue results;
+
+  // Open tabs of this profile, current window first, active tab first.
+  std::vector<BrowserWindowInterface*> windows;
+  if (window) {
+    windows.push_back(window);
+  }
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* other) {
+        if (other != window &&
+            other->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL) {
+          windows.push_back(other);
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+
+  size_t tab_count = 0;
+  for (BrowserWindowInterface* candidate : windows) {
+    TabStripModel* tab_strip = candidate->GetTabStripModel();
+    if (!tab_strip) {
+      continue;
+    }
+    const int active_index = tab_strip->active_index();
+    for (int i = 0; i < tab_strip->count() && tab_count < kMaxTabResults;
+         ++i) {
+      tabs::TabInterface* tab = tab_strip->GetTabAtIndex(i);
+      content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+      if (!contents) {
+        continue;
+      }
+      const GURL& url = contents->GetVisibleURL();
+      const std::u16string& title = contents->GetTitle();
+      if (!ContainsIgnoringCase(title, query_lower) &&
+          !ContainsIgnoringCase(base::UTF8ToUTF16(url.spec()), query_lower)) {
+        continue;
+      }
+      base::DictValue result = MakeResult("tab", title, url);
+      result.Set("tab_id", tab->GetHandle().raw_value());
+      result.Set("active", candidate == window && i == active_index);
+      results.Append(std::move(result));
+      ++tab_count;
+    }
+  }
+
+  // Bookmarks. The model may still be loading during early startup.
+  if (!query.empty()) {
+    bookmarks::BookmarkModel* bookmark_model =
+        BookmarkModelFactory::GetForBrowserContextIfExists(profile);
+    if (bookmark_model && bookmark_model->loaded()) {
+      bookmarks::QueryFields fields;
+      fields.word_phrase_query = std::make_unique<std::u16string>(query);
+      for (const bookmarks::BookmarkNode* node :
+           bookmarks::GetBookmarksMatchingProperties(bookmark_model, fields,
+                                                     kMaxBookmarkResults)) {
+        if (node->is_url()) {
+          results.Append(MakeResult("bookmark", node->GetTitle(), node->url()));
+        }
+      }
+    }
+  }
+
+  history::HistoryService* history_service =
+      HistoryServiceFactory::GetForProfileIfExists(
+          profile, ServiceAccessType::EXPLICIT_ACCESS);
+  if (query.empty() || !history_service) {
+    OnHistoryResults(request_id, std::move(query), std::move(results),
+                     history::QueryResults());
+    return;
+  }
+
+  history::QueryOptions options;
+  options.max_count = kMaxHistoryResults;
+  options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+  history_task_tracker_.TryCancelAll();
+  history_service->QueryHistory(
+      query, options,
+      base::BindOnce(&SteadCommandPaletteUI::OnHistoryResults,
+                     weak_factory_.GetWeakPtr(), request_id, std::move(query),
+                     std::move(results)),
+      &history_task_tracker_);
+}
+
+void SteadCommandPaletteUI::OnHistoryResults(
+    int request_id,
+    std::u16string query,
+    base::ListValue results,
+    history::QueryResults history_results) {
+  for (const history::URLResult& row : history_results) {
+    if (IsSearchableUrl(row.url())) {
+      results.Append(MakeResult("history", row.title(), row.url()));
+    }
+  }
+
+  if (!query.empty()) {
+    // Let the omnibox decide whether the input is a URL or a search, so the
+    // user's default search engine and scheme-fixup rules apply.
+    AutocompleteMatch match;
+    if (AutocompleteClassifier* classifier =
+            AutocompleteClassifierFactory::GetForProfile(
+                Profile::FromWebUI(web_ui()))) {
+      classifier->Classify(query, /*prefer_keyword=*/false,
+                           /*allow_exact_keyword_match=*/false,
+                           metrics::OmniboxEventProto::OTHER, &match, nullptr);
+    }
+    if (match.destination_url.is_valid()) {
+      results.Append(MakeResult(
+          AutocompleteMatch::IsSearchType(match.type) ? "search" : "url",
+          query, match.destination_url));
+    }
+
+    std::string chat_url = std::string(chrome::kSteadChatURL) +
+                           "?source=palette&prompt=" +
+                           base::EscapeQueryParamValue(
+                               base::UTF16ToUTF8(query), /*use_plus=*/true);
+    results.Append(MakeResult("ask", query, GURL(chat_url)));
+  }
+
+  SendResults(request_id, std::move(results));
+}
+
+void SteadCommandPaletteUI::SendResults(int request_id,
+                                        base::ListValue results) {
+  web_ui()->CallJavascriptFunctionUnsafe("steadPaletteResults",
+                                         base::Value(request_id),
+                                         base::Value(std::move(results)));
+}
+
+void SteadCommandPaletteUI::HandleOpen(const base::ListValue& args) {
+  if (args.size() < 3 || !args[0].is_string() || !args[1].is_string() ||
+      !args[2].is_int()) {
+    return;
+  }
+  const std::string& kind = args[0].GetString();
+  const GURL url(args[1].GetString());
+  const int tab_id = args[2].GetInt();
+
+  BrowserWindowInterface* window = GetBrowserWindow();
+  if (!window) {
+    return;
+  }
+
+  if (kind == "tab") {
+    tabs::TabInterface* tab = tabs::TabHandle(tab_id).Get();
+    BrowserWindowInterface* owner =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    TabStripModel* tab_strip = owner ? owner->GetTabStripModel() : nullptr;
+    const int index =
+        tab_strip ? tab_strip->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+    if (index != TabStripModel::kNoTab) {
+      tab_strip->ActivateTabAt(
+          index, TabStripUserGestureDetails(
+                     TabStripUserGestureDetails::GestureType::kKeyboard));
+      owner->GetWindow()->Activate();
+    }
+  } else if (url.is_valid()) {
+    // Everything else replaces the blank tab Cmd+T would have opened.
+    NavigateParams params(window, url,
+                          kind == "search" ? ui::PAGE_TRANSITION_GENERATED
+                                           : ui::PAGE_TRANSITION_TYPED);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&params);
+  }
+
+  if (embedder()) {
+    embedder()->CloseUI();
+  }
+}
+
+WEB_UI_CONTROLLER_TYPE_IMPL(SteadCommandPaletteUI)
