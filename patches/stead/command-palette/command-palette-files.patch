+#ifndef CHROME_BROWSER_UI_VIEWS_STEAD_COMMAND_PALETTE_STEAD_COMMAND_PALETTE_BUBBLE_HOST_H_
+#define CHROME_BROWSER_UI_VIEWS_STEAD_COMMAND_PALETTE_STEAD_COMMAND_PALETTE_BUBBLE_HOST_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
