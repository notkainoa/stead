+
+// Top Chrome WebUI config for the Cmd+T command palette bubble. Auto-resizes
+// so the bubble fits the rendered result list exactly.
+class SteadCommandPaletteUIConfig
+    : public DefaultTopChromeWebUIConfig<SteadCommandPaletteUI> {
+ public:
+  SteadCommandPaletteUIConfig()
+      : DefaultTopChromeWebUIConfig(content::kChromeUIScheme,
+                                    chrome::kSteadCommandPaletteHost) {}
+
+  bool ShouldAutoResizeHost() override;
+};
+
+// Hosts the /command-palette route of the shared Stead SPA bundle inside a
+// WebUIBubbleDialogView (see SteadCommandPaletteBubbleHost). The page drives
+// search over chrome.send() and receives results through
+// window.steadPaletteResults(); every action is scoped to the browser window
+// that opened the bubble.
+class SteadCommandPaletteUI : public TopChromeWebUIController {
+ public:
+  explicit SteadCommandPaletteUI(content::WebUI* web_ui);
+
+  SteadCommandPaletteUI(const SteadCommandPaletteUI&) = delete;
+  SteadCommandPaletteUI& operator=(const SteadCommandPaletteUI&) = delete;
+  ~SteadCommandPaletteUI() override;
+
+  static constexpr std::string_view GetWebUIName() {
+    return "SteadCommandPalette";
+  }
+
+  // Called by the bubble host each time a (possibly cached) bubble is shown
+  // again so the page clears its previous query.
+  void BeforeBubbleWidgetShowed();
+
+ private:
+  void HandleReady(const base::ListValue& args);
+  void HandleClose(const base::ListValue& args);
+  void HandleSearch(const base::ListValue& args);
+  void HandleOpen(const base::ListValue& args);
+
+  void OnHistoryResults(int request_id,
+                        std::u16string query,
+                        base::ListValue results,
+                        history::QueryResults history_results);
+  void SendResults(int request_id, base::ListValue results);
+
+  BrowserWindowInterface* GetBrowserWindow();
+
+  base::CancelableTaskTracker history_task_tracker_;
+  base::WeakPtrFactory<SteadCommandPaletteUI> weak_factory_{this};
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_STEAD_COMMAND_PALETTE_STEAD_COMMAND_PALETTE_UI_H_
